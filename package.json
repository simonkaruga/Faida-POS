{
  "name": "faida-pos",
  "private": true,
  "scripts": {
    "start": "concurrently --kill-others --names api,cloud,web --prefix-colors blue,magenta,green \"npm:start:api\" \"npm:start:cloud\" \"npm:start:web\"",
    "start:api": "cd backend && .venv/bin/uvicorn app.main:create_app --factory --reload --port 8000",
    "start:cloud": "cd backend && .venv/bin/uvicorn app.main:create_app --factory --reload --port 8100 --env-file .env.cloud",
    "start:web": "npm --prefix frontend run dev"
  },
  "devDependencies": {
    "concurrently": "9.1.0"
  }
}
