# The cloud backend (FAIDA_MODE=cloud). Copy to backend/.env.cloud for development.
FAIDA_MODE=cloud
FAIDA_DATABASE_URL=postgresql+psycopg:///faida_cloud?host=/var/run/postgresql
# Signs owner phone logins: a long random string, unique to the cloud.
FAIDA_PIN_SECRET=
# Avinaya's token for /api/admin/health, and where `check-health` alerts go.
FAIDA_ADMIN_TOKEN=
FAIDA_ALERT_WEBHOOK=
# Serve the built phone view (frontend/dist) from the cloud.
# FAIDA_STATIC_DIR=../frontend/dist
