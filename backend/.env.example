# Copy to backend/.env and fill in. Never commit the real file.
FAIDA_MODE=local
FAIDA_DATABASE_URL=postgresql+psycopg:///faida?host=/var/run/postgresql
# A long random string, unique to this counter. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Back it up with the database: without it, staff PINs stop working after a restore.
FAIDA_PIN_SECRET=
FAIDA_TIMEZONE=Africa/Nairobi
# Printers: file:<folder> (development), device:<path> (USB), network:<host>[:port], none
FAIDA_COUNTER_PRINTER=file:prints
FAIDA_KITCHEN_PRINTER=file:prints
# Thermal paper width in mm: 80 (48 characters a line) or 58 (32).
FAIDA_COUNTER_PAPER_MM=80
FAIDA_KITCHEN_PAPER_MM=80
# Counter only (true): nothing leaves the bar. No cloud link, no phone view, nothing queued.
FAIDA_OFFLINE_ONLY=false
# Cloud link: the URL of the Faida cloud, and the token from `register-device` there.
FAIDA_CLOUD_URL=
FAIDA_CLOUD_TOKEN=
# Nightly backup: always encrypted with this passphrase (keep it away from the counter).
FAIDA_BACKUP_PASSPHRASE=
# PostgreSQL's bin folder, if pg_dump isn't on the PATH (Windows: C:\Program Files\PostgreSQL\16\bin)
FAIDA_PG_BIN=
# Where backup status and menu pictures are kept (outside the app folder on a real counter).
FAIDA_STATE_DIR=state
# Email the daily closing (optional). Gmail: smtp.gmail.com, port 587, an app password.
FAIDA_SMTP_HOST=
FAIDA_SMTP_PORT=587
FAIDA_SMTP_USER=
FAIDA_SMTP_PASSWORD=
FAIDA_SMTP_FROM=
# Serve the built counter screens (frontend/dist) from the backend.
# FAIDA_STATIC_DIR=../frontend/dist
