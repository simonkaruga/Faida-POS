# Copy to backend/.env and fill in. Never commit the real file.
FAIDA_MODE=local
FAIDA_DATABASE_URL=postgresql+psycopg://faida@localhost:5544/faida
# A long random string, unique to this counter. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Back it up with the database: without it, staff PINs stop working after a restore.
FAIDA_PIN_SECRET=
FAIDA_TIMEZONE=Africa/Nairobi
# Printers: file:<folder> (development), device:<path> (USB), network:<host>[:port], none
FAIDA_COUNTER_PRINTER=file:prints
FAIDA_KITCHEN_PRINTER=file:prints
