[Unit]
Description=Faida POS counter backend
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=faida
Group=faida
WorkingDirectory=/opt/faida/current/backend
Environment=FAIDA_ENV_FILE=/etc/faida/counter.env
EnvironmentFile=/etc/faida/listen.env
ExecStart=/opt/faida/current/backend/.venv/bin/uvicorn app.main:create_app --factory --host ${FAIDA_HOST} --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
